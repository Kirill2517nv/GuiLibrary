# Артефакты WASM-сборки: кладутся рядом с исходником задания.
#
# Шаблон по расширению, а не список папок: список приходилось дописывать при
# каждом новом задании, а при переименовании Task_4 в LBM он молча перестал
# работать, и собранный .wasm на 900 КБ попал в коммит.
#
# Единственный настоящий .html в репозитории – оболочка web/shell.html.
*.html
*.js
*.wasm
!web/shell.html

# Готовые ответы к заданиям: репозиторий школьники клонируют целиком.
# Task_0_moving – подвижная мишень (задание к Task_0), Demo_Gravity – спутник
# (задание к Task_3, витрина лендинга), Demo_Oscillations – задания 3-6 к
# Task_1 разом, Demo_Pendulum – шаг в пульте, энергия и трение (задания
# 1, 5 и 7 к Task_2). Восстановить неоткуда: держать в резервной копии.
Task_0_moving/
Demo_Gravity/
Demo_Oscillations/
Demo_Pendulum/

# Артефакты локального запуска: отладочные символы MSVC (11 МБ на задачу),
# раскладка окон ImGui и настройки Visual Studio.
*.pdb
imgui.ini
CMakeSettings.json

# Презентации к задачам – локальные материалы преподавателя, в репозиторий не идут
Presentations/
